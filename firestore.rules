rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- HELPERS ---
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
       return isSignedIn() && exists(/databases/$(database)/documents/admin_users/$(request.auth.uid));
    }
    
    // Helper to fetch the user's mapping document once
    function getApprovedUser() {
      let email = (request.auth.token != null && request.auth.token.email != null) ? request.auth.token.email.lower() : "";
      let userPath = /databases/$(database)/documents/approved_users/$(email);
      return exists(userPath) ? get(userPath).data : null;
    }

    function userCompanyId() {
      let user = getApprovedUser();
      return user != null ? (
        (user.keys().hasAll(["companyId"]) && user.companyId != null && user.companyId != "") ? user.companyId :
        (user.keys().hasAll(["orgId"]) && user.orgId != null && user.orgId != "") ? user.orgId : "NONE"
      ) : "NONE";
    }

    function isManager() {
      let user = getApprovedUser();
      // Case-insensitive check: handles "super_admin", "admin", "hr_admin", "manager"
      return user != null && (
        user.role == "super_admin" || user.role == "superadmin" || user.role == "SUPER_ADMIN" ||
        user.role == "admin" || user.role == "Admin" || user.role == "ADMIN" ||
        user.role == "hr_admin" || user.role == "hr" || user.role == "HR_ADMIN" ||
        user.role == "manager" || user.role == "Manager" || user.role == "MANAGER"
      );
    }

    function isOwner(employeeId) {
      return isSignedIn() && 
             (request.auth.token != null && request.auth.token.email != null) && 
             request.auth.token.email.lower() == employeeId.lower();
    }

    // Helper to check if current user is an admin of a specific org
    function isOrgAdmin(orgId) {
      let user = getApprovedUser();
      let isApprovedAdmin = user != null && (
        (user.keys().hasAll(["companyId"]) && user.companyId == orgId) ||
        (user.keys().hasAll(["orgId"]) && user.orgId == orgId)
      ) && (
        user.role == "admin" || user.role == "Admin" || user.role == "ADMIN" ||
        user.role == "hr_admin" || user.role == "HR_ADMIN" || user.role == "hradmin" ||
        user.role == "super_admin" || user.role == "SUPER_ADMIN"
      );
      let memberDoc = /databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid);
      return isApprovedAdmin || (exists(memberDoc) && (
        get(memberDoc).data.role == "admin" ||
        get(memberDoc).data.role == "hr_admin" ||
        get(memberDoc).data.role == "HR_ADMIN" ||
        get(memberDoc).data.role == "super_admin" ||
        get(memberDoc).data.role == "SUPER_ADMIN"
      ));
    }

    function isOrgMember(orgId) {
      return isSignedIn() && (userCompanyId() == orgId || isOrgAdmin(orgId) || isAdmin());
    }

    function isOrgManager(orgId) {
      return isSignedIn() && ((userCompanyId() == orgId && isManager()) || isOrgAdmin(orgId) || isAdmin());
    }

    // 1. Global mapping used during login - Force Case-Insensitive Deploy
    match /approved_users/{email} {
      allow read, write: if isAdmin();
      allow read: if isSignedIn() && (
        isOwner(email) || 
        isManager() ||  // Managers need to check if an email is already registered
        (resource != null && resource.data.companyId == userCompanyId()) || 
        (resource != null && resource.data.keys().hasAll(["orgId"]) && isOrgAdmin(resource.data.orgId)) ||
        isAdmin()
      );
      
      // Managers, HR Admins and Org Admins can create new employee approved_user mappings;
      // Signing up users can create their own initial mapping
      allow create: if isAdmin() || (isSignedIn() && (
        isOwner(email) ||
        (isManager() && request.resource.data.companyId == userCompanyId()) ||
        (request.resource.data.keys().hasAll(["orgId"]) && isOrgAdmin(request.resource.data.orgId))
      ));

      // Users can update their own entry without changing role/companyId (unless completing initial setup)
      // Managers, HR Admins and Org Admins can update their employees
      allow update: if isAdmin() || (isSignedIn() && (
        (isOwner(email) && (
          (request.resource.data.role == resource.data.role && request.resource.data.companyId == resource.data.companyId) ||
          (resource.data.setupComplete == false)
        )) ||
        (isManager() && request.resource.data.companyId == userCompanyId() && resource.data.companyId == userCompanyId()) ||
        (request.resource.data.keys().hasAll(["orgId"]) && isOrgAdmin(request.resource.data.orgId) && resource.data.orgId == request.resource.data.orgId)
      ));

      allow delete: if isAdmin() || (isSignedIn() && (
        (isManager() && resource.data.companyId == userCompanyId()) ||
        (resource.data.keys().hasAll(["orgId"]) && isOrgAdmin(resource.data.orgId))
      ));
    }
    
    match /admin_users/{uid} {
       allow read, write: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }
    
    match /audit_logs/{logId} {
       allow read, write: if isSignedIn();
    }
    
    match /company_users/{uid} {
       allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // --- MAIL EXTENSION ---
    match /mail/{id} {
      allow read, write: if isAdmin();
    }

    // 1.5 Pre-login organization setup requests
    match /organization_setup_requests/{requestId} {
      allow create: if
        request.resource.data.flow == "pre_login_organization_setup" &&
        request.resource.data.status == "pending_admin_setup" &&
        request.resource.data.workspaceStatus == "active" &&
        request.resource.data.organizationName is string &&
        request.resource.data.organizationName.size() > 1 &&
        request.resource.data.contactPerson is string &&
        request.resource.data.contactPerson.size() > 1 &&
        request.resource.data.contactNumber is string &&
        request.resource.data.contactNumber.size() > 5 &&
        request.resource.data.contactEmail is string &&
        request.resource.data.contactEmail.size() > 5 &&
        request.resource.data.addressLine1 is string &&
        request.resource.data.addressLine1.size() > 3 &&
        request.resource.data.city is string &&
        request.resource.data.city.size() > 1 &&
        request.resource.data.state is string &&
        request.resource.data.country is string &&
        request.resource.data.postalCode is string &&
        request.resource.data.postalCode.size() > 3 &&
        request.resource.data.timeZone is string &&
        request.resource.data.organizationType is string &&
        request.resource.data.organizationSize is string;
      allow read, update, delete: if isAdmin();
    }

    // 1.6 Organizations (Secure Multi-Tenant Architecture)
    match /organizations/{orgId} {
      allow read, write: if isAdmin();
      allow read: if isOrgMember(orgId);
      allow create: if isSignedIn();
      allow update: if isOrgManager(orgId);
      allow delete: if isAdmin();
      
      // All nested collections accessible to master super admins
      match /{allSubcollections=**} {
        allow read, write: if isAdmin();
      }
      
      // Member directory & roles
      match /members/{uid} {
        allow read: if isOrgMember(orgId);
        allow write: if isOrgManager(orgId);
      }
      match /departments/{deptId} {
        allow read: if isOrgMember(orgId);
        allow write: if isOrgManager(orgId);
      }
      match /designations/{desigId} {
        allow read: if isOrgMember(orgId);
        allow write: if isOrgManager(orgId);
      }
      match /shifts/{shiftId} {
        allow read: if isOrgMember(orgId);
        allow write: if isOrgManager(orgId);
      }
      match /policies/{policyId} {
        allow read: if isOrgMember(orgId);
        allow write: if isOrgManager(orgId);
      }
      match /locations/{locId} {
        allow read: if isOrgMember(orgId);
        allow write: if isOrgManager(orgId);
      }
      match /branches/{branchId} {
        allow read: if isOrgMember(orgId);
        allow write: if isOrgManager(orgId);
      }
      match /leave_types/{typeId} {
        allow read: if isOrgMember(orgId);
        allow write: if isOrgManager(orgId);
      }
      match /holidays/{holidayId} {
        allow read: if isOrgMember(orgId);
        allow write: if isOrgManager(orgId);
      }

      // Organization users & subcollections
      match /users/{employeeEmail} {
        allow read: if isOrgMember(orgId);
        allow write: if isOrgManager(orgId) || (isOrgMember(orgId) && isOwner(employeeEmail));

        match /attendance/{docId} {
          allow read: if isOrgManager(orgId) || isOwner(employeeEmail);
          allow write: if isOrgManager(orgId) || isOwner(employeeEmail);
        }

        match /leave_requests/{docId} {
          allow read: if isOrgManager(orgId) || isOwner(employeeEmail);
          allow create: if isOwner(employeeEmail);
          allow update: if isOrgManager(orgId) || (isOwner(employeeEmail) && request.resource.data.status == resource.data.status);
          allow delete: if isOrgManager(orgId) || (isOwner(employeeEmail) && resource.data.status == "Pending");
        }

        match /notifications/{docId} {
          allow read, write: if isOwner(employeeEmail) || isOrgManager(orgId) || isOrgMember(orgId);
        }

        match /overtime_requests/{docId} {
          allow read, write: if isOwner(employeeEmail) || isOrgManager(orgId) || isOrgMember(orgId);
        }

        match /notification_meta/{docId} {
          allow read, write: if isOrgManager(orgId) || isOwner(employeeEmail);
        }
      }

      // Top-level Organization Collections
      match /global_notifications/{docId} {
        allow read, write: if isOrgMember(orgId);
      }
      match /attendance/{docId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /leave_requests/{docId} {
        allow read: if isOrgMember(orgId);
        allow create: if isOrgMember(orgId);
        allow update: if isOrgManager(orgId) || (isOrgMember(orgId) && (resource.data.userId == request.auth.uid || isOwner(resource.data.applicantEmail)) && request.resource.data.status == resource.data.status);
        allow delete: if isOrgManager(orgId) || (isOrgMember(orgId) && (resource.data.userId == request.auth.uid || isOwner(resource.data.applicantEmail)) && resource.data.status == "Pending");
      }

      match /announcements/{docId} {
        allow read: if isOrgMember(orgId);
        allow write: if isOrgManager(orgId);
      }

      match /tasks/{docId} {
        allow read: if isOrgMember(orgId);
        allow write: if isOrgMember(orgId);
      }

      match /documents/{docId} {
        allow read: if isOrgMember(orgId);
        allow write: if isOrgMember(orgId);
      }

      match /support_tickets/{docId} {
        allow read: if isOrgMember(orgId);
        allow create: if isOrgMember(orgId);
        allow update, delete: if isOrgManager(orgId);
      }

      match /audit_logs/{docId} {
        allow read: if isOrgManager(orgId);
        allow create: if isOrgMember(orgId);
        allow update, delete: if isAdmin();
      }

      match /settings/{docId} {
        allow read: if isOrgMember(orgId);
        allow write: if isOrgManager(orgId);
      }

      match /notifications/{docId} {
        allow read: if isOrgMember(orgId);
        allow write: if isOrgManager(orgId);
      }

      match /attendance_issues/{docId} {
        allow read: if isOrgMember(orgId);
        allow create: if isOrgMember(orgId);
        allow update: if isOrgManager(orgId) || (isOrgMember(orgId) && (resource.data.createdBy == request.auth.token.email || isOwner(resource.data.createdBy)));
        allow delete: if isOrgManager(orgId);
      }

      match /team_announcements/{docId} {
        allow read: if isOrgMember(orgId);
        allow write: if isOrgManager(orgId);
      }

      match /team_feed/{docId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /outgoing_emails/{docId} {
        allow read, write: if isOrgMember(orgId);
      }
    }


    // 2. Company master data + ALL subcollections
    match /approved_companies/{companyId} {
      // Company document itself
      allow read: if isSignedIn() && (
        userCompanyId() == companyId || 
        isOwner(resource.data.managerEmail) ||
        isAdmin()
      );
      allow create: if isSignedIn() && isOwner(request.resource.data.managerEmail);
      allow update, delete: if isAdmin() || (isSignedIn() && userCompanyId() == companyId && isManager());

      // ── Users subcollection ──────────────────────────────────────
      match /users/{employeeId} {
        allow read: if isSignedIn() && (
          isOwner(employeeId) ||
          (resource != null && isOwner(resource.data.email)) ||
          userCompanyId() == companyId ||
          isAdmin()
        );
        allow write: if isSignedIn() && (
          ((isOwner(employeeId) || isOwner(request.resource.data.email)) && (resource == null || request.resource.data.role == resource.data.role)) ||
          (userCompanyId() == companyId && isManager()) ||
          isAdmin()
        );

        // ── User Attendance ─────────────────────────────────────────
        // Attendance docs stored at users/{email}/attendance/{date}
        match /attendance/{docId} {
          allow read: if isSignedIn() && (
            isOwner(employeeId) ||
            (userCompanyId() == companyId && isManager()) ||
            isAdmin()
          );
          allow write: if isSignedIn() && (
            isOwner(employeeId) ||
            (userCompanyId() == companyId && isManager()) ||
            isAdmin()
          );
        }

        // ── User Leave Requests ─────────────────────────────────────
        match /leave_requests/{docId} {
          allow read: if isSignedIn() && (
            isOwner(employeeId) ||
            (userCompanyId() == companyId && isManager()) ||
            isAdmin()
          );
          allow create: if isSignedIn() && isOwner(employeeId);
          allow update: if isSignedIn() && (
            (isOwner(employeeId) && request.resource.data.status == resource.data.status) ||
            (userCompanyId() == companyId && isManager()) ||
            isAdmin()
          );
          allow delete: if isSignedIn() && (
            (isOwner(employeeId) && resource.data.status == 'pending') ||
            (userCompanyId() == companyId && isManager()) ||
            isAdmin()
          );
        }

        // ── User Notifications ──────────────────────────────────────
        match /notifications/{docId} {
          allow read: if isSignedIn() && (
            isOwner(employeeId) ||
            (userCompanyId() == companyId && isManager()) ||
            isAdmin()
          );
          allow write: if isSignedIn() && (
            isOwner(employeeId) ||   // Employee marks as read
            (userCompanyId() == companyId && isManager()) ||
            isAdmin()
          );
        }

        // ── User Overtime Requests ──────────────────────────────────
        match /overtime_requests/{docId} {
          allow read: if isSignedIn() && (
            isOwner(employeeId) ||
            (userCompanyId() == companyId && isManager()) ||
            isAdmin()
          );
          allow create: if isSignedIn() && isOwner(employeeId);
          allow update: if isSignedIn() && (
            (isOwner(employeeId) && request.resource.data.status == resource.data.status) ||
            (userCompanyId() == companyId && isManager()) ||
            isAdmin()
          );
          allow delete: if isSignedIn() && (
            (isOwner(employeeId) && resource.data.status == 'pending') ||
            (userCompanyId() == companyId && isManager()) ||
            isAdmin()
          );
        }
      }


      // ── Attendance subcollection ─────────────────────────────────────
      match /attendance/{targetUid} {
        allow read, write: if isSignedIn() && (
          request.auth.uid == targetUid ||
          (userCompanyId() == companyId && isManager()) ||
          isAdmin()
        );

        // Attendance records (daily check-in/out)
        match /records/{recordId} {
          allow read, write: if isSignedIn() && (
            request.auth.uid == targetUid ||
            (userCompanyId() == companyId && isManager()) ||
            isAdmin()
          );
        }
      }

      // ── Leave requests subcollection ─────────────────────────────────
      match /leave_requests/{id} {
        allow read: if isSignedIn() && (
          (resource != null && resource.data.userId == request.auth.uid) ||
          (userCompanyId() == companyId && isManager()) ||
          isAdmin()
        );
        allow create: if isSignedIn() && (
          request.resource.data.userId == request.auth.uid &&
          userCompanyId() == companyId
        );
        allow update: if isSignedIn() && (
          (resource != null && resource.data.userId == request.auth.uid && request.resource.data.status == resource.data.status) ||
          (userCompanyId() == companyId && isManager()) ||
          isAdmin()
        );
        allow delete: if isSignedIn() && (
          (resource != null && resource.data.userId == request.auth.uid && resource.data.status == "pending") ||
          (userCompanyId() == companyId && isManager()) ||
          isAdmin()
        );
      }

      // ── Overtime requests subcollection ──────────────────────────────
      match /overtime_requests/{id} {
        allow read: if isSignedIn() && (
          (resource != null && resource.data.userId == request.auth.uid) ||
          (userCompanyId() == companyId && isManager()) ||
          isAdmin()
        );
        allow create: if isSignedIn() && (
          request.resource.data.userId == request.auth.uid &&
          userCompanyId() == companyId
        );
        allow update: if isSignedIn() && (
          (resource != null && resource.data.userId == request.auth.uid && request.resource.data.status == resource.data.status) ||
          (userCompanyId() == companyId && isManager()) ||
          isAdmin()
        );
        allow delete: if isSignedIn() && (
          (resource != null && resource.data.userId == request.auth.uid && resource.data.status == "pending") ||
          (userCompanyId() == companyId && isManager()) ||
          isAdmin()
        );
      }

      // ── Notifications subcollection ──────────────────────────────────
      match /notifications/{id} {
        allow read: if isSignedIn() && (
          (resource != null && resource.data.userId == request.auth.uid) ||
          (userCompanyId() == companyId && isManager()) ||
          isAdmin()
        );
        allow write: if isSignedIn() && (
          (userCompanyId() == companyId && isManager()) ||
          isAdmin()
        );
      }

      // ── Company Calendar ─────────────────────────────────────────────
      // Manager marks holidays / WFH days; all company members can read.
      match /company_calendar/{eventId} {
        allow read: if isSignedIn() && (userCompanyId() == companyId || isAdmin());
        allow write: if isSignedIn() && (
          (userCompanyId() == companyId && isManager()) ||
          isAdmin()
        );
      }

            // ── Global Notifications ─────────────────────────────────────────
      match /global_notifications/{id} {
        allow read: if isSignedIn() && (userCompanyId() == companyId || isAdmin());
        
        // Allows employees to CREATE (send) notifications to the manager
        allow create: if isSignedIn() && (userCompanyId() == companyId || isAdmin());
        
        // Only managers/admins can UPDATE (mark as read) or DELETE notifications
        allow update, delete: if isSignedIn() && (
          (userCompanyId() == companyId && isManager()) ||
          isAdmin()
        );
      }

      // ── Announcements ─────────────────────────────────────────────
      match /announcements/{id} {
        allow read: if isSignedIn() && (userCompanyId() == companyId || isAdmin());
        allow write: if isSignedIn() && (
          (userCompanyId() == companyId && (isManager() || isOrgAdmin(companyId))) ||
          isAdmin()
        );
      }

      // ── Tasks ─────────────────────────────────────────────────────
      match /tasks/{id} {
        allow read: if isSignedIn() && (userCompanyId() == companyId || isAdmin());
        allow write: if isSignedIn() && (
          (userCompanyId() == companyId && (isManager() || isOrgAdmin(companyId))) ||
          isAdmin()
        );
      }

      // ── Feed Posts ────────────────────────────────────────────────
      match /feed_posts/{id} {
        allow read: if isSignedIn() && (userCompanyId() == companyId || isAdmin());
        allow write: if isSignedIn() && (userCompanyId() == companyId || isAdmin());
      }

    } // end match /approved_companies/{companyId}

    // 3. Collection Group Queries (Essential for Managers using collectionGroup) — v2 fix: 2026-05-18
    match /{path=**}/records/{recordId} {
      allow read: if isSignedIn() && (
        // Managers: auth-token check only (no resource.data needed for list queries)
        (isManager() && userCompanyId() != "NONE") ||
        // Employees: own records only
        (resource != null && resource.data.userId == request.auth.uid) ||
        isAdmin()
      );
      allow write: if isSignedIn() && (
        (resource == null && request.resource.data.userId == request.auth.uid && request.resource.data.companyId == userCompanyId()) ||
        (resource != null && resource.data.userId == request.auth.uid) ||
        (isManager() && userCompanyId() != "NONE") ||
        isAdmin()
      );
    }
    
    // Collection group for user-scoped attendance subcollections
    // e.g. approved_companies/{cid}/users/{email}/attendance/{docId}
    match /{path=**}/attendance/{docId} {
      allow read: if isSignedIn() && (
        // Managers: auth-token check only (no resource.data needed for list queries)
        (isManager() && userCompanyId() != "NONE") ||
        // Employees: own records only
        (resource != null && resource.data.userId == request.auth.uid) ||
        isAdmin()
      );
      allow write: if isSignedIn() && (
        (resource == null && request.resource.data.userId == request.auth.uid && request.resource.data.companyId == userCompanyId()) ||
        (resource != null && resource.data.userId == request.auth.uid) ||
        (isManager() && userCompanyId() != "NONE") ||
        isAdmin()
      );
    }

    match /{path=**}/leave_requests/{requestId} {
      allow read: if isSignedIn() && (
        // Managers: auth-token check only (no resource.data needed for list queries)
        (isManager() && userCompanyId() != "NONE") ||
        // Employees: own records only
        (resource != null && resource.data.userId == request.auth.uid) ||
        isAdmin()
      );
      allow write: if isSignedIn() && (
        (resource == null && request.resource.data.userId == request.auth.uid && request.resource.data.companyId == userCompanyId()) ||
        (resource != null && resource.data.userId == request.auth.uid) ||
        (isManager() && userCompanyId() != "NONE") ||
        isAdmin()
      );
    }

    match /{path=**}/attendance_corrections/{requestId} {
      allow read: if isSignedIn() && (
        (isManager() && userCompanyId() != "NONE") ||
        (resource != null && resource.data.userId == request.auth.uid) ||
        isAdmin()
      );
      allow write: if isSignedIn() && (
        (resource == null && request.resource.data.userId == request.auth.uid && request.resource.data.companyId == userCompanyId()) ||
        (resource != null && resource.data.userId == request.auth.uid) ||
        (isManager() && userCompanyId() != "NONE") ||
        isAdmin()
      );
    }

    match /{path=**}/tasks/{taskId} {
      allow read: if isSignedIn() && (
        (isManager() && userCompanyId() != "NONE") ||
        isAdmin()
      );
      allow write: if isSignedIn() && (
        (isManager() && userCompanyId() != "NONE") ||
        isAdmin()
      );
    }

    // 4. Legacy top-level collections (kept for backward compat during migration)
    match /companies/{companyId} {
      allow read, write: if isAdmin();
      // Allow creators, designated managers, and admins to read
      allow read: if isSignedIn() && (
        (resource != null && resource.data.registeredBy == request.auth.uid) || 
        (resource != null && resource.data.managerEmail == request.auth.token.email) ||
        isAdmin()
      );

      // Allow any signed-in user to submit a NEW registration
      allow create: if isSignedIn() && 
        request.resource.data.status == "pending" &&
        request.resource.data.registeredBy == request.auth.uid;

      // Only admins can update status or delete
      allow update: if isAdmin() || (
        isSignedIn() && resource.data.registeredBy == request.auth.uid &&
        request.resource.data.status == resource.data.status // Prevent self-approval
      );
      
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        request.auth.token.email == userId || 
        (resource != null && resource.data.email == request.auth.token.email) ||
        (resource != null && resource.data.companyId == userCompanyId()) ||
        isAdmin()
      );
      allow write: if isSignedIn() && (
        request.auth.uid == userId ||
        (request.auth.token.email == userId && (resource == null || request.resource.data.role == resource.data.role)) ||
        (resource == null && request.resource.data.companyId == userCompanyId() && isManager()) ||
        (resource != null && resource.data.companyId == userCompanyId() && isManager()) ||
        isAdmin()
      );
    }

    match /user/{userEmail} {
      allow read, write: if isSignedIn() && (
        isOwner(userEmail) ||
        (isManager() && userCompanyId() != "NONE") ||
        isAdmin()
      );
    }

    match /notifications/{id} {
      allow read: if isSignedIn() && (
        (resource != null && resource.data.userId == request.auth.uid) ||
        (resource != null && resource.data.companyId == userCompanyId() && isManager()) ||
        isAdmin()
      );
      allow write: if isSignedIn() && (
        (resource == null && request.resource.data.companyId == userCompanyId() && isManager()) ||
        (resource != null && resource.data.companyId == userCompanyId() && isManager()) ||
        isAdmin()
      );
    }

    match /leave_requests/{id} {
      allow read: if isSignedIn() && (
        (resource != null && resource.data.userId == request.auth.uid) ||
        (resource != null && resource.data.companyId == userCompanyId() && isManager()) ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.companyId == userCompanyId()
      );
      allow update: if isSignedIn() && (
        (resource != null && resource.data.userId == request.auth.uid && request.resource.data.status == resource.data.status) ||
        (resource != null && resource.data.companyId == userCompanyId() && isManager()) ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (
        (resource != null && resource.data.userId == request.auth.uid && resource.data.status == "pending") ||
        (resource != null && resource.data.companyId == userCompanyId() && isManager()) ||
        isAdmin()
      );
    }

    match /overtime_requests/{id} {
      allow read: if isSignedIn() && (
        (resource != null && resource.data.userId == request.auth.uid) ||
        (resource != null && resource.data.companyId == userCompanyId() && isManager()) ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.companyId == userCompanyId()
      );
      allow update: if isSignedIn() && (
        (resource != null && resource.data.userId == request.auth.uid && request.resource.data.status == resource.data.status) ||
        (resource != null && resource.data.companyId == userCompanyId() && isManager()) ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (
        (resource != null && resource.data.userId == request.auth.uid && resource.data.status == "pending") ||
        (resource != null && resource.data.companyId == userCompanyId() && isManager()) ||
        isAdmin()
      );
    }

    // 5. Fallbacks (Closed)
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
