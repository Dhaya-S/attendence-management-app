rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Workzi HRMS – Firestore security rules (multi-tenant)
//
// Principles
//  • Every company lives in its own tree: organizations/{companyId}/…
//  • A user's company + role come ONLY from approved_users/{email}. Users can
//    never change their own company or role (except joining an organization
//    they themselves created during setup).
//  • The HR Admin (head of organization) has full access to their company.
//  • Managers / Employees get features according to the company's
//    featurePermissions matrix (set by the HR Admin).
//  • Nobody can read or write another company's data.
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Identity helpers ─────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    // Safe even for sign-in methods without an email (token.get avoids a missing-key error)
    function myEmail() {
      return request.auth != null ? string(request.auth.token.get("email", "")).lower() : "";
    }

    function hasEmail() {
      return myEmail() != "";
    }

    // Platform super admin (Workzi staff). Only another platform admin can create these.
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admin_users/$(request.auth.uid));
    }

    function approvedUserPath() {
      return /databases/$(database)/documents/approved_users/$(myEmail());
    }

    // Path is only built when the caller has an email (an empty segment would be an invalid path)
    function getApprovedUser() {
      return (hasEmail() && exists(approvedUserPath())) ? get(approvedUserPath()).data : null;
    }

    // The caller's company. "NONE" when not assigned or suspended/removed.
    function myCompanyId() {
      let u = getApprovedUser();
      let cid = u != null ? u.get("companyId", null) : null;
      let st = u != null ? string(u.get("status", "approved")).lower() : "";
      return (cid is string && cid != "" && cid != "default" && st != "suspended" && st != "removed")
        ? cid : "NONE";
    }

    function myRole() {
      let u = getApprovedUser();
      return u != null ? string(u.get("role", "")).lower() : "";
    }

    function isHrRole(r) {
      return r in ["super_admin", "superadmin", "admin", "hr_admin", "hr"];
    }

    function isManagerRole(r) {
      return isHrRole(r) || r == "manager";
    }

    function isManager() {
      return isManagerRole(myRole());
    }

    function isOwner(e) {
      return isSignedIn() && hasEmail() && myEmail() == string(e).lower();
    }

    function newData() {
      return request.resource.data;
    }

    function unchanged(keys) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
    }

    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ── Organization helpers ─────────────────────────────────────────────────

    function orgPath(orgId) {
      return /databases/$(database)/documents/organizations/$(orgId);
    }

    // The person who created the organization (setup wizard) – head of organization
    function isOrgOwner(orgId) {
      return isSignedIn() && hasEmail() && exists(orgPath(orgId)) &&
        string(get(orgPath(orgId)).data.get("superAdminEmail", "")).lower() == myEmail();
    }

    // HR Admin of THIS organization (full access)
    function isOrgHrAdmin(orgId) {
      return isSignedIn() && (
        isAdmin() ||
        isOrgOwner(orgId) ||
        (myCompanyId() == orgId && isHrRole(myRole()))
      );
    }

    function isOrgManager(orgId) {
      return isSignedIn() && (isOrgHrAdmin(orgId) || (myCompanyId() == orgId && isManager()));
    }

    function isOrgMember(orgId) {
      return isSignedIn() && (myCompanyId() == orgId || isOrgHrAdmin(orgId));
    }

    // Feature permission matrix set by the HR Admin: organizations/{orgId}.featurePermissions
    // Defaults mirror DEFAULT_FEATURE_PERMISSIONS in AuthContext.tsx
    function roleHasFeature(orgId, feature) {
      let fp = get(orgPath(orgId)).data.get("featurePermissions", {
        "manager": ["approval", "task_creation", "announcement_creation", "geofencing"],
        "employee": ["geofencing"]
      });
      let roleKey = myRole() == "manager" ? "manager" : "employee";
      return fp.get(roleKey, []).hasAny([feature]);
    }

    // HR Admin always; other members only if the HR Admin granted the feature
    function canUseFeature(orgId, feature) {
      return isOrgHrAdmin(orgId) || (myCompanyId() == orgId && exists(orgPath(orgId)) && roleHasFeature(orgId, feature));
    }

    function canApprove(orgId) {
      return canUseFeature(orgId, "approval");
    }

    // ── 1. approved_users/{email}: login → company + role mapping ────────────
    match /approved_users/{email} {
      allow get: if isSignedIn() && (
        isOwner(email) ||
        isAdmin() ||
        resource == null ||                                   // "is this email free?" check
        (myCompanyId() != "NONE" && resource.data.get("companyId", null) == myCompanyId())
      );
      allow list: if isSignedIn() && (
        isAdmin() ||
        (myCompanyId() != "NONE" && resource.data.companyId == myCompanyId())
      );

      allow create: if isSignedIn() && (
        isAdmin() ||
        // self sign-up: no company yet, or the company this user just created
        (isOwner(email) && (
          newData().get("companyId", null) == null ||
          newData().get("companyId", null) == "" ||
          (newData().get("companyId", null) is string && isOrgOwner(newData().companyId))
        )) ||
        // HR / managers adding someone to THEIR company (only HR can create HR admins)
        (newData().get("companyId", null) is string &&
          newData().companyId == myCompanyId() &&
          canUseFeature(newData().companyId, "organization") &&
          (!isHrRole(string(newData().get("role", "")).lower()) || isOrgHrAdmin(newData().companyId)))
      );

      allow update: if isSignedIn() && (
        isAdmin() ||
        // own record: cannot change company / role / status …
        (isOwner(email) && (
          unchanged(["companyId", "orgId", "role", "status"]) ||
          // … except leaving to "no company" (new-organization onboarding)
          (newData().get("companyId", null) == null && newData().get("orgId", null) == null) ||
          // … or joining the organization they created themselves
          (newData().get("companyId", null) is string && isOrgOwner(newData().companyId))
        )) ||
        // HR / managers of the SAME company (cannot move people to another company)
        (resource.data.get("companyId", null) is string &&
          resource.data.companyId == myCompanyId() &&
          newData().get("companyId", null) == resource.data.companyId &&
          isOrgManager(resource.data.companyId) &&
          (unchanged(["role", "status"]) || canUseFeature(resource.data.companyId, "organization")) &&
          (unchanged(["role"]) || isOrgHrAdmin(resource.data.companyId)) &&
          (!isHrRole(string(resource.data.get("role", "")).lower()) || isOrgHrAdmin(resource.data.companyId)))
      );

      allow delete: if isAdmin() || (
        resource.data.get("companyId", null) is string && isOrgHrAdmin(resource.data.companyId)
      );
    }

    // Platform admins – nobody can make themselves an admin
    match /admin_users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    match /company_users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    match /user_preferences/{email} {
      allow read, write: if isOwner(email) || isAdmin();
    }

    // --- MAIL EXTENSION ---
    match /mail/{id} {
      allow read, write: if isAdmin();
    }

    // Pre-login organization setup requests
    match /organization_setup_requests/{requestId} {
      allow create: if
        request.resource.data.flow == "pre_login_organization_setup" &&
        request.resource.data.status == "pending_admin_setup" &&
        request.resource.data.workspaceStatus == "active" &&
        request.resource.data.organizationName is string &&
        request.resource.data.organizationName.size() > 1 &&
        request.resource.data.contactPerson is string &&
        request.resource.data.contactPerson.size() > 1 &&
        request.resource.data.contactNumber is string &&
        request.resource.data.contactNumber.size() > 5 &&
        request.resource.data.contactEmail is string &&
        request.resource.data.contactEmail.size() > 5 &&
        request.resource.data.addressLine1 is string &&
        request.resource.data.addressLine1.size() > 3 &&
        request.resource.data.city is string &&
        request.resource.data.city.size() > 1 &&
        request.resource.data.state is string &&
        request.resource.data.country is string &&
        request.resource.data.postalCode is string &&
        request.resource.data.postalCode.size() > 3 &&
        request.resource.data.timeZone is string &&
        request.resource.data.organizationType is string &&
        request.resource.data.organizationSize is string;
      allow read, update, delete: if isAdmin();
    }

    // ── 2. organizations/{orgId}: one tree per company ───────────────────────
    match /organizations/{orgId} {
      allow get: if isSignedIn() && (
        resource == null ||                                   // ID availability check during setup
        isOrgMember(orgId) ||
        (hasEmail() && string(resource.data.get("superAdminEmail", "")).lower() == myEmail())
      );
      allow list: if isAdmin();

      // The creator becomes the head of organization (superAdminEmail = creator)
      allow create: if isSignedIn() && hasEmail() &&
        string(newData().get("superAdminEmail", "")).lower() == myEmail();

      allow update: if isAdmin() ||
        isOrgOwner(orgId) ||
        (isOrgHrAdmin(orgId) && unchanged(["superAdminEmail"])) ||
        (canUseFeature(orgId, "organization") &&
          unchanged(["superAdminEmail", "managerEmail", "featurePermissions", "adminDetails", "smtpConfig"]));

      allow delete: if isAdmin();

      match /{allSubcollections=**} {
        allow read, write: if isAdmin();
      }

      match /members/{uid} {
        allow read: if isOrgMember(orgId);
        allow write: if isOrgHrAdmin(orgId);
      }

      // Organization structure – HR, or roles granted "organization"
      match /departments/{deptId} {
        allow read: if isOrgMember(orgId);
        allow write: if canUseFeature(orgId, "organization");
      }
      match /designations/{desigId} {
        allow read: if isOrgMember(orgId);
        allow write: if canUseFeature(orgId, "organization");
      }
      match /shifts/{shiftId} {
        allow read: if isOrgMember(orgId);
        allow write: if canUseFeature(orgId, "organization");
      }
      match /policies/{policyId} {
        allow read: if isOrgMember(orgId);
        allow write: if canUseFeature(orgId, "organization");
      }
      match /locations/{locId} {
        allow read: if isOrgMember(orgId);
        allow write: if canUseFeature(orgId, "organization");
      }
      match /branches/{branchId} {
        allow read: if isOrgMember(orgId);
        allow write: if canUseFeature(orgId, "organization");
      }
      match /leave_types/{typeId} {
        allow read: if isOrgMember(orgId);
        allow write: if canUseFeature(orgId, "organization");
      }
      match /holidays/{holidayId} {
        allow read: if isOrgMember(orgId);
        allow write: if canUseFeature(orgId, "organization");
      }

      // Employee directory
      match /users/{employeeEmail} {
        allow read: if isOrgMember(orgId);
        allow create: if canUseFeature(orgId, "organization");
        allow update: if canUseFeature(orgId, "organization") ||
          // employees update their own live status (check-in / out) but not job details
          (isOrgMember(orgId) && isOwner(employeeEmail) &&
            unchanged(["role", "roleLabel", "status", "companyId", "orgId", "dept", "department",
                       "designation", "manager", "managerEmail", "branch", "shift", "empType", "isDeptHead", "uid"])) ||
          // approvers fixing attendance after an approved regularisation
          (canApprove(orgId) &&
            onlyChanged(["attendanceStatus", "lastCheckIn", "lastCheckOut", "lastCheckInTime", "lastCheckOutTime", "updatedAt"]));
        allow delete: if isOrgHrAdmin(orgId);

        match /attendance/{docId} {
          allow read: if isOrgManager(orgId) || isOwner(employeeEmail);
          allow write: if isOwner(employeeEmail) && isOrgMember(orgId) || canApprove(orgId);
        }

        match /leave_requests/{docId} {
          allow read: if isOrgManager(orgId) || isOwner(employeeEmail);
          allow create: if isOwner(employeeEmail) && isOrgMember(orgId) && newData().get("status", "") == "Pending";
          allow update: if canApprove(orgId) || (isOwner(employeeEmail) && (
            unchanged(["status", "approvedBy", "approvedAt", "rejectedBy", "rejectedAt"]) ||
            (resource.data.get("status", "") == "Pending" && newData().get("status", "") == "Cancelled" &&
              unchanged(["approvedBy", "approvedAt", "rejectedBy", "rejectedAt"]))
          ));
          allow delete: if canApprove(orgId) || (isOwner(employeeEmail) && resource.data.get("status", "") == "Pending");
        }

        match /documents/{docId} {
          allow read: if isOrgManager(orgId) || isOwner(employeeEmail);
          allow write: if canUseFeature(orgId, "organization");
        }

        match /notification_meta/{docId} {
          allow read, write: if isOwner(employeeEmail) && isOrgMember(orgId) || isOrgHrAdmin(orgId);
        }

        // Personal notifications (written by the mobile app / managers) + the user's own
        // settings docs (settings, privacy, security)
        match /notifications/{docId} {
          allow read: if isOwner(employeeEmail) || isOrgManager(orgId);
          allow create: if isOrgMember(orgId);
          allow update, delete: if isOwner(employeeEmail) || isOrgManager(orgId);
        }

        // Overtime requests (mobile app) – same approval model as leave_requests
        match /overtime_requests/{docId} {
          allow read: if isOrgManager(orgId) || isOwner(employeeEmail);
          allow create: if isOwner(employeeEmail) && isOrgMember(orgId) && newData().get("status", "") == "Pending";
          allow update: if canApprove(orgId) || (isOwner(employeeEmail) &&
            unchanged(["status", "approvedBy", "approvedAt", "rejectedBy", "rejectedAt"]));
          allow delete: if canApprove(orgId) || (isOwner(employeeEmail) && resource.data.get("status", "") == "Pending");
        }
      }

      // Company-wide attendance feed (one doc per employee per day)
      match /attendance/{docId} {
        allow read: if isOrgMember(orgId);
        allow create: if isOrgMember(orgId) && (isOwner(newData().get("email", "")) || canApprove(orgId));
        allow update: if isOrgMember(orgId) && (isOwner(resource.data.get("email", "")) || canApprove(orgId)) &&
          unchanged(["email", "companyId"]);
        allow delete: if isOrgHrAdmin(orgId);
      }

      // Company-wide leave queue
      match /leave_requests/{docId} {
        allow read: if isOrgMember(orgId);
        allow create: if isOrgMember(orgId) &&
          isOwner(newData().get("applicantEmail", "")) &&
          newData().get("status", "") == "Pending";
        allow update: if canApprove(orgId) || (
          isOrgMember(orgId) &&
          (resource.data.get("userId", "") == request.auth.uid || isOwner(resource.data.get("applicantEmail", ""))) &&
          unchanged(["applicantEmail", "userId", "approvedBy", "approvedAt", "rejectedBy", "rejectedAt"]) &&
          (unchanged(["status"]) ||
            (resource.data.get("status", "") == "Pending" && newData().get("status", "") == "Cancelled"))
        );
        allow delete: if canApprove(orgId) || (
          isOrgMember(orgId) &&
          (resource.data.get("userId", "") == request.auth.uid || isOwner(resource.data.get("applicantEmail", ""))) &&
          resource.data.get("status", "") == "Pending"
        );
      }

      match /attendance_issues/{docId} {
        allow read: if isOrgMember(orgId);
        allow create: if isOrgMember(orgId) && isOwner(newData().get("createdBy", "")) &&
          newData().get("status", "") == "Pending";
        allow update: if canApprove(orgId) || (
          isOrgMember(orgId) && isOwner(resource.data.get("createdBy", "")) &&
          unchanged(["status", "createdBy", "approvedBy", "approvedAt", "rejectedBy", "rejectedAt"])
        );
        allow delete: if isOrgHrAdmin(orgId);
      }

      match /announcements/{docId} {
        allow read: if isOrgMember(orgId);
        allow write: if canUseFeature(orgId, "announcement_creation");
        // any member may like / comment / count a view (engagement fields only)
        allow update: if isOrgMember(orgId) &&
          onlyChanged(["likes", "likedBy", "commentsCount", "views"]);

        match /comments/{commentId} {
          allow read: if isOrgMember(orgId);
          allow create: if isOrgMember(orgId);
          allow update, delete: if isOrgManager(orgId) ||
            (isOrgMember(orgId) && isOwner(resource.data.get("authorEmail", "")));
        }
      }

      match /team_announcements/{docId} {
        allow read: if isOrgMember(orgId);
        allow write: if canUseFeature(orgId, "announcement_creation");
        allow update: if isOrgMember(orgId) &&
          onlyChanged(["likes", "likedBy", "commentsCount", "views"]);

        match /comments/{commentId} {
          allow read: if isOrgMember(orgId);
          allow create: if isOrgMember(orgId);
          allow update, delete: if isOrgManager(orgId) ||
            (isOrgMember(orgId) && isOwner(resource.data.get("authorEmail", "")));
        }
      }

      // Alerts for managers (e.g. "new leave request") – anyone can raise one, managers read them
      match /global_notifications/{docId} {
        allow read: if isOrgManager(orgId);
        allow create: if isOrgMember(orgId);
        allow update, delete: if isOrgManager(orgId);
      }

      match /tasks/{docId} {
        allow read: if isOrgMember(orgId);
        allow create: if canUseFeature(orgId, "task_creation");
        allow update: if isOrgMember(orgId);                  // assignees move their own tasks
        allow delete: if canUseFeature(orgId, "task_creation");
      }

      match /documents/{docId} {
        allow read: if isOrgMember(orgId);
        allow create: if isOrgMember(orgId);
        allow update, delete: if isOrgManager(orgId);
      }

      match /team_feed/{docId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /support_tickets/{docId} {
        allow read: if isOrgMember(orgId);
        allow create: if isOrgMember(orgId);
        allow update, delete: if isOrgManager(orgId);
      }

      match /audit_logs/{docId} {
        allow read: if isOrgHrAdmin(orgId);
        allow create: if isOrgMember(orgId);
        allow update, delete: if isAdmin();
      }

      match /settings/{docId} {
        allow read: if isOrgMember(orgId);
        allow write: if isOrgHrAdmin(orgId);
      }

      match /notifications/{docId} {
        allow read: if isOrgMember(orgId);
        allow write: if isOrgManager(orgId);
      }

      match /outgoing_emails/{docId} {
        allow create: if isOrgMember(orgId);
        allow read, update, delete: if isOrgManager(orgId);
      }
    }

    // ── 3. Legacy company tree (kept for the mobile app) ─────────────────────
    match /approved_companies/{companyId} {
      allow read: if isSignedIn() && (
        myCompanyId() == companyId ||
        (resource != null && isOwner(resource.data.get("managerEmail", ""))) ||
        isAdmin()
      );
      allow create: if isSignedIn() && isOwner(request.resource.data.get("managerEmail", ""));
      allow update, delete: if isAdmin() || isOrgHrAdmin(companyId);

      match /users/{employeeId} {
        allow read: if isSignedIn() && (
          isOwner(employeeId) ||
          (resource != null && isOwner(resource.data.get("email", ""))) ||
          myCompanyId() == companyId ||
          isAdmin()
        );
        allow write: if isSignedIn() && (
          ((isOwner(employeeId) || isOwner(request.resource.data.get("email", ""))) &&
            (resource == null || request.resource.data.get("role", "") == resource.data.get("role", ""))) &&
            myCompanyId() == companyId ||
          (myCompanyId() == companyId && isManager()) ||
          isAdmin()
        );

        match /attendance/{docId} {
          allow read, write: if isSignedIn() && (
            (isOwner(employeeId) && myCompanyId() == companyId) ||
            (myCompanyId() == companyId && isManager()) ||
            isAdmin()
          );
        }

        match /leave_requests/{docId} {
          allow read: if isSignedIn() && (
            isOwner(employeeId) || (myCompanyId() == companyId && isManager()) || isAdmin()
          );
          allow create: if isSignedIn() && isOwner(employeeId) && myCompanyId() == companyId;
          allow update: if isSignedIn() && (
            (isOwner(employeeId) && request.resource.data.status == resource.data.status) ||
            (myCompanyId() == companyId && isManager()) || isAdmin()
          );
          allow delete: if isSignedIn() && (
            (isOwner(employeeId) && resource.data.status in ["pending", "Pending"]) ||
            (myCompanyId() == companyId && isManager()) || isAdmin()
          );
        }

        match /notifications/{docId} {
          allow read, write: if isSignedIn() && (
            isOwner(employeeId) || (myCompanyId() == companyId && isManager()) || isAdmin()
          );
        }

        match /overtime_requests/{docId} {
          allow read: if isSignedIn() && (
            isOwner(employeeId) || (myCompanyId() == companyId && isManager()) || isAdmin()
          );
          allow create: if isSignedIn() && isOwner(employeeId) && myCompanyId() == companyId;
          allow update: if isSignedIn() && (
            (isOwner(employeeId) && request.resource.data.status == resource.data.status) ||
            (myCompanyId() == companyId && isManager()) || isAdmin()
          );
          allow delete: if isSignedIn() && (
            (isOwner(employeeId) && resource.data.status in ["pending", "Pending"]) ||
            (myCompanyId() == companyId && isManager()) || isAdmin()
          );
        }
      }

      match /attendance/{targetUid} {
        allow read, write: if isSignedIn() && (
          (request.auth.uid == targetUid && myCompanyId() == companyId) ||
          (myCompanyId() == companyId && isManager()) || isAdmin()
        );
        match /records/{recordId} {
          allow read, write: if isSignedIn() && (
            (request.auth.uid == targetUid && myCompanyId() == companyId) ||
            (myCompanyId() == companyId && isManager()) || isAdmin()
          );
        }
      }

      match /leave_requests/{id} {
        allow read: if isSignedIn() && (
          (resource != null && resource.data.userId == request.auth.uid) ||
          (myCompanyId() == companyId && isManager()) || isAdmin()
        );
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && myCompanyId() == companyId;
        allow update: if isSignedIn() && (
          (resource != null && resource.data.userId == request.auth.uid && request.resource.data.status == resource.data.status) ||
          (myCompanyId() == companyId && isManager()) || isAdmin()
        );
        allow delete: if isSignedIn() && (
          (resource != null && resource.data.userId == request.auth.uid && resource.data.status in ["pending", "Pending"]) ||
          (myCompanyId() == companyId && isManager()) || isAdmin()
        );
      }

      match /overtime_requests/{id} {
        allow read: if isSignedIn() && (
          (resource != null && resource.data.userId == request.auth.uid) ||
          (myCompanyId() == companyId && isManager()) || isAdmin()
        );
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && myCompanyId() == companyId;
        allow update: if isSignedIn() && (
          (resource != null && resource.data.userId == request.auth.uid && request.resource.data.status == resource.data.status) ||
          (myCompanyId() == companyId && isManager()) || isAdmin()
        );
        allow delete: if isSignedIn() && (
          (resource != null && resource.data.userId == request.auth.uid && resource.data.status in ["pending", "Pending"]) ||
          (myCompanyId() == companyId && isManager()) || isAdmin()
        );
      }

      match /notifications/{id} {
        allow read: if isSignedIn() && (
          (resource != null && resource.data.userId == request.auth.uid) ||
          (myCompanyId() == companyId && isManager()) || isAdmin()
        );
        allow write: if isSignedIn() && ((myCompanyId() == companyId && isManager()) || isAdmin());
      }

      match /company_calendar/{eventId} {
        allow read: if isSignedIn() && (myCompanyId() == companyId || isAdmin());
        allow write: if isSignedIn() && ((myCompanyId() == companyId && isManager()) || isAdmin());
      }

      match /global_notifications/{id} {
        allow read, create: if isSignedIn() && (myCompanyId() == companyId || isAdmin());
        allow update, delete: if isSignedIn() && ((myCompanyId() == companyId && isManager()) || isAdmin());
      }

      match /announcements/{id} {
        allow read: if isSignedIn() && (myCompanyId() == companyId || isAdmin());
        allow write: if isSignedIn() && ((myCompanyId() == companyId && isManager()) || isAdmin());
      }

      match /tasks/{id} {
        allow read: if isSignedIn() && (myCompanyId() == companyId || isAdmin());
        allow write: if isSignedIn() && ((myCompanyId() == companyId && isManager()) || isAdmin());
      }

      match /feed_posts/{id} {
        allow read, write: if isSignedIn() && (myCompanyId() == companyId || isAdmin());
      }
    }

    // ── 4. Collection-group access – ALWAYS scoped to the caller's company ───
    // (Collection-group queries must filter: where("companyId", "==", myCompanyId))
    match /{path=**}/records/{recordId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.get("userId", "") == request.auth.uid ||
        (isManager() && myCompanyId() != "NONE" && resource.data.get("companyId", "") == myCompanyId())
      );
    }

    match /{path=**}/attendance/{docId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.get("userId", "") == request.auth.uid ||
        (isManager() && myCompanyId() != "NONE" && resource.data.get("companyId", "") == myCompanyId())
      );
      // Writes for paths that have no company in their path (e.g. users/{email}/attendance/{date})
      allow create: if isSignedIn() && myCompanyId() != "NONE" &&
        request.resource.data.get("companyId", "") == myCompanyId() &&
        (request.resource.data.get("userId", "") == request.auth.uid || isManager() || canApprove(myCompanyId()));
      allow update: if isSignedIn() && myCompanyId() != "NONE" &&
        resource.data.get("companyId", "") == myCompanyId() &&
        request.resource.data.get("companyId", "") == myCompanyId() &&
        (resource.data.get("userId", "") == request.auth.uid || isManager() || canApprove(myCompanyId()));
    }

    match /{path=**}/leave_requests/{requestId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.get("userId", "") == request.auth.uid ||
        (isManager() && myCompanyId() != "NONE" && resource.data.get("companyId", "") == myCompanyId())
      );
    }

    match /{path=**}/attendance_corrections/{requestId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.get("userId", "") == request.auth.uid ||
        (isManager() && myCompanyId() != "NONE" && resource.data.get("companyId", "") == myCompanyId())
      );
      allow create: if isSignedIn() && myCompanyId() != "NONE" &&
        request.resource.data.get("userId", "") == request.auth.uid &&
        request.resource.data.get("companyId", "") == myCompanyId();
      allow update: if isSignedIn() && myCompanyId() != "NONE" &&
        resource.data.get("companyId", "") == myCompanyId() &&
        request.resource.data.get("companyId", "") == myCompanyId() &&
        (isManager() || (resource.data.get("userId", "") == request.auth.uid &&
                         request.resource.data.get("status", "") == resource.data.get("status", "")));
    }

    match /{path=**}/tasks/{taskId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        (myCompanyId() != "NONE" && resource.data.get("companyId", "") == myCompanyId())
      );
    }

    // Login org-discovery (mobile app): collectionGroup("users").where("email", "==", myEmail)
    match /{path=**}/users/{userId} {
      allow read: if isSignedIn() && hasEmail() &&
        string(resource.data.get("email", "")).lower() == myEmail();
    }

    // ── 5. Legacy top-level collections ──────────────────────────────────────
    match /companies/{companyId} {
      allow read: if isSignedIn() && (
        (resource != null && resource.data.get("registeredBy", "") == request.auth.uid) ||
        (resource != null && isOwner(resource.data.get("managerEmail", ""))) ||
        (resource != null && isOwner(resource.data.get("superAdminEmail", ""))) ||
        myCompanyId() == companyId ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        isOrgOwner(companyId) ||
        (request.resource.data.get("status", "") == "pending" && request.resource.data.get("registeredBy", "") == request.auth.uid)
      );
      allow update: if isAdmin() || isOrgHrAdmin(companyId) || (
        isSignedIn() && resource.data.get("registeredBy", "") == request.auth.uid &&
        request.resource.data.get("status", "") == resource.data.get("status", "")
      );
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        isOwner(userId) ||
        (resource != null && isOwner(resource.data.get("email", ""))) ||
        (myCompanyId() != "NONE" && resource != null && resource.data.get("companyId", "") == myCompanyId()) ||
        isAdmin()
      );
      allow write: if isSignedIn() && (
        ((request.auth.uid == userId || isOwner(userId)) &&
          (resource == null || unchanged(["role", "companyId", "orgId"]))) ||
        (myCompanyId() != "NONE" && isManager() && request.resource.data.get("companyId", "") == myCompanyId() &&
          (resource == null || resource.data.get("companyId", "") == myCompanyId())) ||
        isAdmin()
      );
    }

    match /user/{userEmail} {
      allow read: if isSignedIn() && (
        isOwner(userEmail) ||
        (myCompanyId() != "NONE" && isManager() && resource != null && resource.data.get("companyId", "") == myCompanyId()) ||
        isAdmin()
      );
      allow write: if isSignedIn() && (
        (isOwner(userEmail) && (resource == null || unchanged(["role", "companyId", "orgId"]))) ||
        (myCompanyId() != "NONE" && isManager() && request.resource.data.get("companyId", "") == myCompanyId() &&
          (resource == null || resource.data.get("companyId", "") == myCompanyId())) ||
        isAdmin()
      );
    }

    match /notifications/{id} {
      allow read: if isSignedIn() && (
        (resource != null && resource.data.get("userId", "") == request.auth.uid) ||
        (resource != null && myCompanyId() != "NONE" && resource.data.get("companyId", "") == myCompanyId() && isManager()) ||
        isAdmin()
      );
      allow write: if isSignedIn() && (
        (myCompanyId() != "NONE" && request.resource.data.get("companyId", "") == myCompanyId() && isManager() &&
          (resource == null || resource.data.get("companyId", "") == myCompanyId())) ||
        isAdmin()
      );
    }

    match /leave_requests/{id} {
      allow read: if isSignedIn() && (
        (resource != null && resource.data.userId == request.auth.uid) ||
        (resource != null && myCompanyId() != "NONE" && resource.data.companyId == myCompanyId() && isManager()) ||
        isAdmin()
      );
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.companyId == myCompanyId();
      allow update: if isSignedIn() && (
        (resource != null && resource.data.userId == request.auth.uid && request.resource.data.status == resource.data.status) ||
        (resource != null && myCompanyId() != "NONE" && resource.data.companyId == myCompanyId() && isManager()) ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (
        (resource != null && resource.data.userId == request.auth.uid && resource.data.status in ["pending", "Pending"]) ||
        (resource != null && myCompanyId() != "NONE" && resource.data.companyId == myCompanyId() && isManager()) ||
        isAdmin()
      );
    }

    match /overtime_requests/{id} {
      allow read: if isSignedIn() && (
        (resource != null && resource.data.userId == request.auth.uid) ||
        (resource != null && myCompanyId() != "NONE" && resource.data.companyId == myCompanyId() && isManager()) ||
        isAdmin()
      );
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.companyId == myCompanyId();
      allow update: if isSignedIn() && (
        (resource != null && resource.data.userId == request.auth.uid && request.resource.data.status == resource.data.status) ||
        (resource != null && myCompanyId() != "NONE" && resource.data.companyId == myCompanyId() && isManager()) ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (
        (resource != null && resource.data.userId == request.auth.uid && resource.data.status in ["pending", "Pending"]) ||
        (resource != null && myCompanyId() != "NONE" && resource.data.companyId == myCompanyId() && isManager()) ||
        isAdmin()
      );
    }

    // ── 6. Everything else: platform admins only ─────────────────────────────
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
